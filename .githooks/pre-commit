#!/bin/sh
# Pre-commit hook: scan staged files for potential secrets and placeholder values.
# Install: git config core.hooksPath .githooks
set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

violations=0

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(html?|js|ts|py|sh|ya?ml|json|toml|env|txt)$' || true)

[ -z "$staged_files" ] && exit 0

while IFS= read -r file; do
  [ -z "$file" ] && continue

  # Get staged content
  content=$(git show ":${file}" 2>/dev/null || true)
  [ -z "$content" ] && continue

  lineno=0
  while IFS= read -r line; do
    lineno=$((lineno + 1))

    # Check 1: Truncated hex hashes (e.g. "2ff51f...bf7e", 'a1b2...c3d4')
    if echo "$line" | grep -qE '[0-9a-fA-F]{4,}\.\.\.[0-9a-fA-F]{4,}'; then
      echo "${RED}⚠ SECURITY:${NC} $file:$lineno — Truncated hex hash detected (contains '...')"
      echo "  $line"
      violations=$((violations + 1))
    fi

    # Check 2: Variable assignments with placeholder patterns near sensitive names
    # Must be an actual assignment — the old form matched any line containing
    # both "placeholder" and "password", i.e. every <input type="password">.
    if echo "$line" | grep -qiE '(HASH|PASSWORD|SECRET|API_KEY|TOKEN|PRIVATE_KEY)[A-Z_]*\s*[=:]\s*[''"]?(TODO|FIXME|XXX|CHANGE_ME|PLACEHOLDER|YOUR_)'; then
      echo "${YELLOW}⚠ WARNING:${NC} $file:$lineno — sensitive variable assigned a placeholder"
      echo "  $line"
      violations=$((violations + 1))
    fi

    # Check 3: Variable name like HASH/PASSWORD assigned to a value containing "..."
    if echo "$line" | grep -qiE '(HASH|PASSWORD|SECRET)\s*[=:]\s*[''"][^''"]*\.\.\.[^''"]*[''"]'; then
      echo "${RED}⚠ SECURITY:${NC} $file:$lineno — Sensitive variable assigned truncated value"
      echo "  $line"
      violations=$((violations + 1))
    fi
  done <<EOF
$content
EOF
done <<EOF
$staged_files
EOF

# Check 4: published pages must be encrypted loaders, never plaintext.
# Everything GitHub Pages serves lives at the repo root; sources live in _src/.
# A root-level index.html without the ciphertext payload means someone edited a
# built file directly, or committed before running ./build.py.
published=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^([a-zA-Z0-9._-]+/)?index\.html$' \
  | grep -v '^_src/' || true)

for file in $published; do
  content=$(git show ":${file}" 2>/dev/null || true)
  [ -z "$content" ] && continue

  if ! echo "$content" | grep -q 'id="pg-payload"'; then
    echo "${RED}⚠ PLAINTEXT:${NC} $file — published page has no encrypted payload."
    echo "  Edit _src/$file instead, then run ./build.py and stage the result."
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  echo ""
  echo "${RED}✗ Found $violations problem(s) in staged files.${NC}"
  echo "  To bypass (e.g. for false positives): git commit --no-verify"
  exit 1
fi

exit 0
